# Absolute origin of this deploy. Used for canonical links, share-card URLs and
# the snippets on /embed. Only truly needed in production  Vercel's own URL and
# localhost are sensible fallbacks.
NEXT_PUBLIC_SITE_URL=https://stern-docs.hackclub.com

# owner/repo holding this site. Powers "Suggest an edit", which is the entire
# contribution model. Defaults to AD-Archer/stern-docs; set it if you're running a
# fork, so edit links land on your copy instead of upstream.
NEXT_PUBLIC_CONTENT_REPO=AD-Archer/stern-docs
NEXT_PUBLIC_CONTENT_BRANCH=main

NEXT_PUBLIC_AUTHOR_NAME=archer
NEXT_PUBLIC_AUTHOR_URL=https://hackclub.enterprise.slack.com/archives/C0BHZLZF8BX

# Which program `/` redirects to.
NEXT_PUBLIC_DEFAULT_PROGRAM=CloudFALL
STERN_API_BASE=https://stern.hackclub.com

# Plausible, self-hosted and cookieless. DOMAIN must match the site name as it's
# registered in Plausible, not the URL this deploy happens to be served from.
# Both have working defaults; unset, a fork still reports as the real site, so
# set DOMAIN on a fork or leave the tracker to be blocked.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=sterndocs.hackclub.com
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.adarcher.app
# Off by default: local page loads shouldn't land in production stats.
NEXT_PUBLIC_PLAUSIBLE_CAPTURE_LOCALHOST=false
